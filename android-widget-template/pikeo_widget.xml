<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent" android:layout_height="match_parent"
  android:orientation="horizontal" android:padding="4dp"
  android:background="#F5F7FA">
  <LinearLayout android:id="@+id/widget_barcode" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
    android:gravity="center" android:orientation="vertical" android:contentDescription="Créer un code-barres">
    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/pikeo_widget_barcode" android:contentDescription="@null"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Code-barres" android:textSize="10sp" android:textColor="#182C45"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/widget_missing" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
    android:gravity="center" android:orientation="vertical" android:contentDescription="Ajouter un manquant">
    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/pikeo_widget_plus" android:contentDescription="@null"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Manquant" android:textSize="10sp" android:textColor="#182C45"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/widget_products" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
    android:gravity="center" android:orientation="vertical" android:contentDescription="Liste des produits">
    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/pikeo_widget_box" android:contentDescription="@null"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Produits" android:textSize="10sp" android:textColor="#182C45"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/widget_enf" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
    android:gravity="center" android:orientation="vertical" android:contentDescription="Consulter les ENF">
    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/pikeo_widget_layers" android:contentDescription="@null"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="ENF" android:textSize="10sp" android:textColor="#182C45"/>
  </LinearLayout>
</LinearLayout>
